DATABASE_URL=postgresql://user:password@localhost:5432/exam_app
NODE_ENV=development
PORT=3002
JWT_SECRET=change_me
CLIENT_ORIGIN=http://localhost:5173

# Optional — enables POST /api/questions/generate (AI-generated exam questions).
# Without it, that endpoint returns 503 and the rest of the app is unaffected.
# Free tier key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override, defaults to gemini-3.5-flash
GEMINI_MODEL=
